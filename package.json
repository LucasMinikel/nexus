    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
